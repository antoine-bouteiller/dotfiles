#!/bin/sh -e
#
# Fresh NixOS install for a host already declared in this flake.
# Run from the NixOS installer ISO, with this repo checked out and staged:
#
#   nix run --extra-experimental-features 'nix-command flakes' .#bootstrap -- antoine-dell
#
# Requires the host to have a disko config (hosts/<name>/disko.nix). Afterwards:
#   1. restart, clone this repo, `nix run .#apply`
#   2. `nix run .#secure-boot` to enroll the Secure Boot keys and the LUKS TPM2 slot

# Under `curl | sh` stdin is the pipe, so disko's wipe confirmation would read EOF
# and abort. Reattach the terminal once for the whole script.
[ -t 0 ] || exec </dev/tty

host="$1"
if [ -z "$host" ]; then
  echo "usage: nix run .#bootstrap -- <flake-hostname>" >&2
  exit 1
fi

# The ISO only trusts cache.nixos.org, so everything the caches in hosts/base.nix
# would serve (lanzaboote, custom pkgs) would otherwise be built from source.
# Also carries the experimental features: the sudo'd nix calls below read root's
# nix.conf, which on the ISO has neither nix-command nor flakes.
NIX_CONFIG="extra-experimental-features = nix-command flakes
extra-substituters = https://nix-community.cachix.org https://antoine-bouteiller.cachix.org https://noctalia.cachix.org
extra-trusted-public-keys = nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs= antoine-bouteiller.cachix.org-1:vtMtdYM8LJ3CRDrqiTllxXRnu4x3xwYOb6317TUJUTc= noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4="
export NIX_CONFIG
sudo() { command sudo --preserve-env=NIX_CONFIG "$@"; }

echo "Partitioning, formatting and mounting..."
sudo nix run github:nix-community/disko/latest -- --mode destroy,format,mount --flake ".#${host}"

# lanzaboote signs the very first generation, so the keys must exist before the
# install; sbctl in the target system then finds them at /var/lib/sbctl.
echo "Creating Secure Boot keys..."
sudo install -d -m 700 /mnt/var/lib/sbctl
sudo nix run nixpkgs#sbctl -- create-keys --disable-landlock \
  --export /mnt/var/lib/sbctl --database-path /mnt/var/lib/sbctl/GUID

echo "Installing..."
sudo nixos-install --flake ".#${host}" --no-root-password

echo "Install complete. Restart, then follow the post-install steps in apps/x86_64-linux/bootstrap."
