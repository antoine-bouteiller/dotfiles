#!/usr/bin/env nu
# Secure Boot + TPM2 bring-up on an installed host, run as:
#
#   nix run .#secure-boot
#
# The procedure spans two restarts, so this script detects the phase it is in and
# is meant to be re-run after each one until it reports "nothing left to do":
#
#   1. keys enrolled into firmware (needs the firmware in Setup Mode)
#   2. once Secure Boot is actually active, the LUKS TPM2 slot is enrolled
#      against PCR 7 -- doing it earlier seals against the wrong PCR 7 value
#
# The keys themselves are created by `nix run .#bootstrap` before the install,
# because lanzaboote cannot sign the first generation without them.

def fail [message: string] {
  print -e $message
  exit 1
}

# sbctl needs root to read the efivars, otherwise it reports nothing at all.
def sbctl-status [] {
  ^sudo sbctl status --json | from json
}

def luks-device [] {
  let devices = (^lsblk --json --list --output PATH,FSTYPE
    | from json
    | get blockdevices
    | where fstype == crypto_LUKS
    | get path)
  if ($devices | length) != 1 {
    fail $"Expected exactly one crypto_LUKS device, found: ($devices | str join ' ')"
  }
  $devices.0
}

if not ((sbctl-status).secure_boot) {
  # Out of Setup Mode with Secure Boot off means the keys are already enrolled
  # and only the firmware toggle is missing; enroll-keys can only fail here.
  if not ((sbctl-status).setup_mode) {
    print 'Keys are already enrolled. Enable Secure Boot in the firmware, then re-run this.'
    exit 0
  }
  # lanzaboote bundles the kernel and initrd into signed UKIs, so the raw
  # /EFI/nixos/* blobs left next to them are expected to be unsigned.
  # sbctl verifies against our local db key, not Microsoft's. Windows files
  # keep their vendor signatures; --microsoft below enrolls their trust roots.
  # Firmware, not this local-key check, validates the Windows bootloader.
  print 'Verifying local signatures (excluding raw NixOS blobs and Windows files)...'
  # sbctl verify exits nonzero when the expected raw NixOS blobs are unsigned.
  let verify = (^sudo sbctl verify | complete)
  if not ($verify.stderr | is-empty) {
    print -e $verify.stderr
  }
  let unsigned = ($verify.stdout | lines | where {|line| ($line | str contains 'is not signed') and not ($line =~ '/EFI/(nixos|Microsoft/Boot)/') })
  if not ($unsigned | is-empty) {
    $unsigned | str join "\n" | print -e
    exit 1
  }
  print 'Enrolling keys (firmware must be in Setup Mode)...'
  ^sudo sbctl enroll-keys --microsoft
  print 'Keys enrolled. Restart, confirm Secure Boot is on in the firmware, then re-run this.'
  exit 0
}

let device = (luks-device)
let luks_dump = (^sudo cryptsetup luksDump $device)
if ($luks_dump | str contains 'systemd-tpm2') {
  print $"Secure Boot is active and ($device) already has a TPM2 slot: nothing left to do."
  exit 0
}

print $"Enrolling a TPM2 slot on ($device) against PCR 7 (the passphrase stays as recovery)..."
^sudo systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 $device
print 'Done. Restart to check that the root unlocks without a passphrase.'
