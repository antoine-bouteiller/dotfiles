#!/usr/bin/env nu

use ../private-config.nu *

def main --wrapped [...args: string] {
  let config = (private-config)
  let split_args = (split-nh-args $args)

  print 'Applying darwin configuration...'
  let host = (^hostname -s | str trim)
  ^nh darwin switch $config.public_ref -H $host ...$split_args.nh_args -- ...$split_args.nix_args ...$config.nix_args
  print 'Switch to new generation complete!'
  source clean
}
