#!/usr/bin/env nu
# Install/reinstall onto existing filesystems mounted under /mnt. Never partitions
# or formats: see README.md for the manual layout, mounting and Secure Boot steps.
#
#   nix run .#bootstrap -- plex-server

use ../config.nu *
use ../age-keys.nu *

def fail [message: string] {
  print -e $message
  exit 1
}

def --wrapped sudo [...args] {
  ^sudo --preserve-env=NIX_CONFIG ...$args
}

def check-mount [target: string, device: string] {
  let actual = (try {
    sudo findmnt --raw --noheadings --mountpoint $target --output UUID,FSROOT | str trim
  } catch {
    fail $"Mount ($device) at ($target) before running bootstrap."
  })
  let expected = (try {
    sudo blkid -s UUID -o value $device | str trim
  } catch {
    fail $"Cannot identify ($device)."
  })
  if ($expected | is-empty) or $actual != $"($expected) /" {
    fail $"($target) must mount the filesystem root of configured device ($device); refusing to install."
  }
}

# The ISO cannot push, so re-encrypted secrets go to the installed flakePath checkout,
# copied from the current checkout or cloned when running from the read-only /etc/dotfiles.
def prepare-checkout [checkout: string] {
  let source = (^git rev-parse --show-toplevel | complete)
  let source = if $source.exit_code == 0 { $source.stdout | str trim } else { null }
  if $source == $checkout {
    return
  }
  let exists = (try { sudo test -e $checkout; true } catch { false })
  if $exists {
    fail $"($checkout) already exists: run bootstrap from it."
  }
  sudo install -d -o (^id -u | str trim) ($checkout | path dirname)
  if $source == null {
    ^git clone ($env.DOTFILES_REPO? | default 'https://github.com/antoine-bouteiller/dotfiles.git') $checkout
  } else {
    ^cp -a $"($source)/." $checkout
  }
}

def main [...args: string] {
  if ($args | length) != 1 {
    fail 'usage: nix run .#bootstrap -- <flake-hostname>'
  }
  let host = $args.0
  if ($host | is-empty) or ($host | str starts-with '-') or not ($host =~ '^[a-zA-Z0-9_-]+$') {
    fail 'usage: nix run .#bootstrap -- <flake-hostname>'
  }

  # The ISO only trusts cache.nixos.org, so everything the caches in hosts/base.nix
  # would serve (lanzaboote, custom pkgs) would otherwise be built from source.
  # Also carries the experimental features: the sudo'd nix calls below read root's
  # nix.conf, which on the ISO has neither nix-command nor flakes.
  $env.NIX_CONFIG = (nix-config)
  let config = $".#nixosConfigurations.($host).config"

  # Force NixOS assertions (including missing hardware) before any target writes.
  print $"Validating ($host)..."
  ^nix eval --raw $"($config).system.build.toplevel.drvPath" out> /dev/null
  let root_device = (^nix eval --raw $"($config).fileSystems.\"/\".device" | str trim)
  let efi_mount = (^nix eval --raw $"($config).boot.loader.efi.efiSysMountPoint" | str trim)
  let efi_device = (^nix eval --raw $"($config).fileSystems.\"($efi_mount)\".device" | str trim)
  let secure_boot = (^nix eval --json $"($config).secureBoot.enable" | str trim)
  let host_args = (^nix eval --json $".#nixosConfigurations.($host)._module.specialArgs.host" | from json)
  let flake_path = (^nix eval --raw $"($config).flakePath" | str trim)
  let key_file = $"/mnt(^nix eval --raw $"($config).sops.age.keyFile" | str trim)"

  # ponytail: current hosts use ext4 root and FAT EFI; add subvolume validation before supporting Btrfs.
  check-mount /mnt $root_device
  check-mount $"/mnt($efi_mount)" $efi_device

  let fresh_install = (try { sudo test -e /mnt/etc/shadow; false } catch { true })

  if $secure_boot == 'true' {
    let keydir = '/mnt/var/lib/sbctl'
    let keydir_exists = (try { sudo test -e $keydir; true } catch { false })
    if $keydir_exists {
      # Refuse incomplete state instead of replacing firmware-enrolled keys.
      for file in [GUID keys/PK/PK.key keys/PK/PK.pem keys/KEK/KEK.key keys/KEK/KEK.pem keys/db/db.key keys/db/db.pem] {
        try {
          sudo test -s $"($keydir)/($file)"
        } catch {
          fail $"Incomplete Secure Boot keys: restore ($keydir) before installing."
        }
      }
      print 'Preserving existing Secure Boot keys.'
    } else {
      let installed = (try { sudo test -e /mnt/etc/NIXOS; true } catch { false })
      if $installed {
        fail $"Restore the installed system's Secure Boot keys to ($keydir) before reinstalling."
      }
      print 'Creating Secure Boot keys...'
      sudo install -d -m 700 $keydir
      sudo nix run nixpkgs#sbctl -- create-keys --disable-landlock --export $"($keydir)/keys" --database-path $"($keydir)/GUID"
    }
  }

  # A reinstall keeps its age key; secrets are re-encrypted only when .sops.yaml lacks it.
  let key_exists = (try { sudo test -s $key_file; true } catch { false })
  let current = if $key_exists { recipient-from-file $key_file } else { null }
  let flake = if $current != null and (recipient .sops.yaml $host_args.name) == $current {
    print $"Keeping ($key_file)."
    '.'
  } else {
    let checkout = $"/mnt($flake_path)"
    prepare-checkout $checkout
    if $current == null {
      print $"Creating ($key_file)..."
      let key = generate-key
      reencrypt $checkout $host_args.name $key.recipient {|| install-key $key_file $key.identity }
    } else {
      reencrypt $checkout $host_args.name $current {||}
    }
    $checkout
  }

  print 'Installing without formatting mounted filesystems...'
  sudo nixos-install --root /mnt --flake $"($flake)#($host)" --no-root-password

  # Fresh accounts would otherwise be locked. Do not reset reinstall credentials.
  if $fresh_install {
    print 'Setting the login password...'
    # Under curl | sh, interactive steps must read the terminal, not the script pipe.
    let password_command = 'passwd "$(id -nu 1000)"'
    let stdin_is_terminal = ((^test -t 0 | complete).exit_code == 0)
    try {
      if $stdin_is_terminal {
        sudo nixos-enter --root /mnt -c $password_command
      } else {
        ^sh -c 'exec </dev/tty; exec sudo --preserve-env=NIX_CONFIG nixos-enter --root /mnt -c "$1"' -- $password_command
      }
    } catch {
      fail $"Password not set. Re-run: sudo nixos-enter --root /mnt -c '($password_command)'"
    }
  }

  if $flake != '.' {
    sudo nixos-enter --root /mnt -c $"chown -R ($host_args.user): ($flake_path)"
    print $"After restarting, commit and push .sops.yaml and secrets/ from ($flake_path): the remote does not list this host's key yet."
  }
  print 'Install complete. Restart; see README.md for post-install steps.'
}
