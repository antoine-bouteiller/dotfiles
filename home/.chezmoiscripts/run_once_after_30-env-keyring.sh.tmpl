#!/bin/sh
set -eu

# Copy the custom fields of each Bitwarden item below into the keyring
# (service = item name, user = field name). Add items here as needed.
# Re-run with:
#   chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
items="openai google_dev_recipe_organizer"

export BW_SESSION="${BW_SESSION:-$(bw unlock --raw)}"
bw sync
for item in $items; do
  bw get item "$item" | jq -r '.fields[] | [.name, .value] | @tsv' |
  while IFS="$(printf '\t')" read -r name value; do
    {{ .chezmoi.executable }} secret keyring set --service="$item" --user="$name" --value="$value"
  done
done
