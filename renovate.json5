{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":disableRateLimiting",
    ":ignoreUnstable",
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  configMigration: true,
  dependencyDashboard: false,
  minimumReleaseAge: "1 day",
  labels: ["renovate"],
  automergeStrategy: "rebase",
  commitMessageExtra: "( {{currentVersion}} ➜ {{newVersion}} )",
  nix: { enabled: true },
  // Branch-tracking flake inputs lack a pinned rev, so only lock file maintenance updates them.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-3 * * 0"],
    commitMessageExtra: "",
    semanticCommitType: "chore",
    semanticCommitScope: "deps",
    automerge: true,
    automergeType: "pr",
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/\\.nix$/"],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*image\\s*=\\s*"[^"@]+@(?<currentDigest>sha256:[a-f0-9]{64})";\\s*#\\s*(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ["digest"],
      commitMessageExtra: "( {{currentDigestShort}} ➜ {{newDigestShort}} )",
    },
    {
      matchManagers: ["custom.regex"],
      pinDigests: true,
      semanticCommitType: "chore",
      semanticCommitScope: "deps",
    },
    {
      description: "Auto-merge patch, minor and digest updates",
      matchUpdateTypes: ["patch", "minor", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge GitHub Actions patch and digest updates",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
    },
  ],
}
