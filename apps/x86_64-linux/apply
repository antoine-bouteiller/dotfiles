#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../private-config.sh"

private_config_init
private_config_split_nh_args "$@"

echo "Applying NixOS configuration..."
host=$(host_attr nixos)
nh os switch "$PRIVATE_CONFIG_PUBLIC_REF" -H "$host" "${PRIVATE_CONFIG_NH_ARGS[@]}" -- \
  "${PRIVATE_CONFIG_CALLER_NIX_ARGS[@]}" "${PRIVATE_CONFIG_NIX_ARGS[@]}"
echo "Switch to new generation complete!"
