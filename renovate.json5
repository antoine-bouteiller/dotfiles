{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>antoine-bouteiller/renovate"],
  commitMessageExtra: "( {{currentVersion}} ➜ {{newVersion}} )",
  nix: { enabled: false },
  // vite-plus is updated by update.nu.
  ignorePaths: ["pkgs/vite-plus/npm/**"],
  lockFileMaintenance: { enabled: false },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/\\.nix$/"],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*image\\s*=\\s*"[^"@]+@(?<currentDigest>sha256:[a-f0-9]{64})";\\s*#\\s*(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      matchManagers: ["custom.regex"],
      pinDigests: true,
      semanticCommitType: "chore",
      semanticCommitScope: "deps",
    },
    {
      description: "Auto-merge digest updates",
      matchUpdateTypes: ["digest"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
