{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":disableRateLimiting",
    ":ignoreUnstable",
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  configMigration: true,
  dependencyDashboard: false,
  minimumReleaseAge: "1 day",
  labels: ["renovate"],
  automergeStrategy: "rebase",
  commitMessageExtra: "( {{currentVersion}} ➜ {{newVersion}} )",
  nix: { enabled: true },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/\\.nix$/"],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*image\\s*=\\s*"[^"@]+@(?<currentDigest>sha256:[a-f0-9]{64})";\\s*#\\s*(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ["digest"],
      commitMessageExtra: "( {{currentDigestShort}} ➜ {{newDigestShort}} )",
    },
    {
      description: "One PR per flake input; app inputs daily",
      matchManagers: ["nix"],
      additionalBranchPrefix: "nix/",
      semanticCommitType: "chore",
      semanticCommitScope: "deps",
      // git-refs digests carry no release timestamp, which minimumReleaseAge would block forever.
      minimumReleaseAge: null,
      schedule: ["* 0-3 * * *"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Global flake inputs weekly",
      matchManagers: ["nix"],
      matchDepNames: ["nixpkgs", "nixpkgs-unstable", "home-manager", "darwin", "nixos-hardware"],
      schedule: ["* 0-3 * * 0"],
    },
    {
      matchManagers: ["custom.regex"],
      pinDigests: true,
      semanticCommitType: "chore",
      semanticCommitScope: "deps",
    },
    {
      description: "Auto-merge patch, minor and digest updates",
      matchUpdateTypes: ["patch", "minor", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge GitHub Actions patch and digest updates",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
    },
  ],
}
