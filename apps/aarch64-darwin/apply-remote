#!/usr/bin/env nu
use ../private-config.nu
use ../config.nu nix-config

# SSH always parses a shell command, even when the payload is a Nushell script.
def shell-quote [value: string]: nothing -> string {
  "'" + ($value | str replace --all "'" "'\"'\"'") + "'"
}

def remote-command [expected_user: string, command: string]: nothing -> string {
  let script = [
    $"EXPECTED_USER=(shell-quote $expected_user)"
    $"export NIX_CONFIG=(shell-quote $env.NIX_CONFIG)"
    r#'set -euo pipefail
if [[ $(id -un) != "$EXPECTED_USER" ]]; then
  echo 'SSH login must match the evaluated VM home username' >&2
  exit 1
fi
for profile in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
  if ! command -v nix >/dev/null && [[ -f "$profile" ]]; then . "$profile"; fi
done'#
    $command
  ] | str join "\n"
  # Nix splits remote-program on whitespace, including quoted script/config newlines.
  let wrapper = 'eval "$(printf %s ' + ($script | encode base64) + ' | base64 --decode)"'
  $"bash -l -c (shell-quote $wrapper) --"
}

def source-paths [archive: record]: nothing -> list<string> {
  [$archive.path] ++ ($archive.inputs | values | each {|input| source-paths $input } | flatten)
}

def main [target: string] {
  if $target !~ '^[a-z_][a-z0-9_-]{0,31}@((([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)*[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)|(\[[0-9A-Fa-f:.]+\]))$' {
    error make {msg: 'Usage: nix run .#apply-remote -- <user>@<vm-host>'}
  }
  $env.NIX_CONFIG = [($env.NIX_CONFIG? | default '') (nix-config)] | str join "\n"
  let config = private-config
  let archive = ^nix flake archive --json $config.public_ref ...$config.nix_args | from json
  let public_source = $archive.path
  let private_source = $archive.inputs.privateConfig.path
  let deployment = ^nix eval --json $"($public_source)#homeConfigurations.vm" --no-write-lock-file --override-input privateConfig $"path:($private_source)" --apply 'home: {
    username = home.config.home.username;
    drvPath = home.activationPackage.drvPath;
    nushell = { inherit (home.pkgs.nushell) drvPath; output = home.pkgs.nushell.outPath; };
    nh = { inherit (home.pkgs.nh) drvPath; output = home.pkgs.nh.outPath; };
    nix = let runtime = home.pkgs.buildEnv {
      name = "remote-nix";
      paths = [ home.pkgs.nix home.pkgs.cacert ];
    }; in { inherit (runtime) drvPath; output = runtime.outPath; version = home.pkgs.nix.version; };
  }' | from json
  let expected_user = $deployment.username
  if $expected_user in ['' ci-user] {
    error make {msg: 'remote deployment requires a configured non-CI vm home username'}
  }

  let roots = $"/nix/var/nix/gcroots/dotfiles-(random uuid)"
  let sources = source-paths $archive | uniq
  let derivations = [$deployment.drvPath $deployment.nushell.drvPath $deployment.nh.drvPath $deployment.nix.drvPath]

  # Bootstrap upstream Nix; preparation then installs the exact flake-selected package.
  let install = $"NIX_VERSION=(shell-quote $deployment.nix.version)\n" + r#'sudo -n true || { echo 'Remote deployment requires passwordless sudo' >&2; exit 1; }
if ! command -v nix >/dev/null; then
  curl -fsSL "https://releases.nixos.org/nix/nix-$NIX_VERSION/install" | sh -s -- --daemon --yes
fi
config=/etc/nix/nix.conf
if sudo grep -Eq "^!?include nix\\.custom\\.conf$" "$config"; then
  config=/etc/nix/nix.custom.conf
fi
trusted_user="extra-trusted-users = $EXPECTED_USER"
if ! sudo grep -Fxq "$trusted_user" "$config" 2>/dev/null; then
  printf "\n%s\n" "$trusted_user" | sudo tee -a "$config" >/dev/null
fi
sudo systemctl restart nix-daemon'#
  ^ssh -A -t -- $target (remote-command $expected_user $install)

  let cleanup = $"sudo rm -rf -- (shell-quote $roots)"
  try {
    # Direct dangling roots survive GC. Holding its lock during each import makes
    # them valid before a collector can scan roots, without a transfer-to-root gap.
    let paths = $sources ++ $derivations | each {|path| shell-quote $path } | str join ' '
    let create_roots = [
      $"sudo install -d -m 700 -o (shell-quote $expected_user) (shell-quote $roots)"
      $"for path in ($paths); do"
      $'  ln -s "$path" (shell-quote $roots)/"${path##*/}"'
      'done'
    ] | str join "\n"
    ^ssh -t -- $target (remote-command $expected_user $create_roots)
    let store_command = remote-command $expected_user 'exec sudo -n --preserve-env=NIX_CONFIG flock --shared /nix/var/nix/gc.lock /nix/var/nix/profiles/default/bin/nix-store --option min-free 0 "$@"'
    let destination = $"ssh://($target)?remote-program=($store_command | url encode --all)"
    ^nix copy --to $destination ...$sources
    ^nix copy --derivation --to $destination ...$derivations

    let build_tools = [nix build --out-link $"($roots)/tools" $"($deployment.nushell.drvPath)^out" $"($deployment.nh.drvPath)^out" $"($deployment.nix.drvPath)^out"] | each {|arg| shell-quote $arg } | str join ' '
    let remote_nu = [$"($deployment.nushell.output)/bin/nu" --no-config-file $"($public_source)/apps/remote.nu"]
    let prepare = $remote_nu ++ [prepare $expected_user $deployment.nix.output] | each {|arg| shell-quote $arg } | str join ' '
    ^ssh -A -t -- $target (remote-command $expected_user $"($build_tools); exec ($prepare)")

    # Reconnect after AcceptEnv is configured so activation receives the SOPS key.
    let activate = $remote_nu ++ [activate $expected_user $deployment.drvPath $"($deployment.nh.output)/bin/nh" $"($roots)/home"] | each {|arg| shell-quote $arg } | str join ' '
    ^ssh -A -o SendEnv=SOPS_AGE_KEY -t -- $target (remote-command $expected_user $"exec ($activate)")
  } catch {|err|
    ^ssh -- $target (remote-command $expected_user $cleanup)
    error make $err
  }
  ^ssh -- $target (remote-command $expected_user $cleanup)
}
