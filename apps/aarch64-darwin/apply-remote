#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../private-config.sh"

if [[ $# -ne 1 || ! $1 =~ ^[a-z_][a-z0-9_-]{0,31}@((([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)*[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)|(\[[0-9A-Fa-f:.]+\]))$ ]]; then
  echo "Usage: nix run .#apply-remote -- <user>@<vm-host>" >&2
  exit 2
fi
target=$1
private_config_remote_init
expected_user=$(nix --extra-experimental-features 'nix-command flakes' eval --raw \
  "$PRIVATE_CONFIG_PUBLIC_REF#homeConfigurations.vm.config.home.username" "${PRIVATE_CONFIG_NIX_ARGS[@]}")
if [[ -z $expected_user || $expected_user == ci-user ]]; then
  echo 'remote deployment requires a configured non-CI vm home username' >&2
  exit 1
fi

remote_script=$(cat <<'REMOTE'
set -euo pipefail
if [[ $(id -un) != "$EXPECTED_USER" ]]; then
  echo 'SSH login must match the evaluated VM home username' >&2
  exit 1
fi
for profile in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
  if ! command -v nix >/dev/null && [[ -f "$profile" ]]; then . "$profile"; fi
done
if ! command -v nix >/dev/null; then
  curl -fsSL https://install.determinate.systems/nix | sh -s -- install --no-confirm
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
sudo mkdir -p /etc/nix /etc/ssh/sshd_config.d
sudo tee /etc/nix/dotfiles.conf >/dev/null <<'NIX_CONFIG'
extra-experimental-features = nix-command flakes
extra-substituters = https://nix-community.cachix.org https://antoine-bouteiller.cachix.org https://noctalia.cachix.org
extra-trusted-public-keys = nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs= antoine-bouteiller.cachix.org-1:vtMtdYM8LJ3CRDrqiTllxXRnu4x3xwYOb6317TUJUTc= noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4=
NIX_CONFIG
if ! sudo grep -qxF 'include dotfiles.conf' /etc/nix/nix.conf 2>/dev/null; then
  printf '\ninclude dotfiles.conf\n' | sudo tee -a /etc/nix/nix.conf >/dev/null
fi
sudo systemctl restart nix-daemon
echo 'AcceptEnv SOPS_AGE_KEY' | sudo tee /etc/ssh/sshd_config.d/50-sops-age.conf >/dev/null
sudo systemctl reload ssh
build_args=(--no-write-lock-file)
if [[ -n $PRIVATE_OVERRIDE ]]; then build_args+=(--override-input privateConfig "$PRIVATE_OVERRIDE"); fi
out=$(nix --extra-experimental-features 'nix-command flakes' build --no-link --print-out-paths \
  "$PUBLIC_REF#homeConfigurations.vm.activationPackage" "${build_args[@]}")
"$out/activate"
REMOTE
)
shell_quote() {
  printf "'%s'" "${1//\'/\'\"\'\"\'}"
}
printf -v remote_script 'EXPECTED_USER=%s\nPUBLIC_REF=%s\nPRIVATE_OVERRIDE=%s\n%s' \
  "$(shell_quote "$expected_user")" "$(shell_quote "$PRIVATE_CONFIG_PUBLIC_REF")" \
  "$(shell_quote "$PRIVATE_CONFIG_REMOTE_OVERRIDE")" "$remote_script"
remote_command="bash -l -c $(shell_quote "$remote_script")"
exec ssh -A -o SendEnv=SOPS_AGE_KEY -t -- "$target" "$remote_command"
